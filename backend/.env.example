# --- Required ---
PORT=5000
MONGODB_URI=mongodb://localhost:27017/transport_tracking
JWT_SECRET=change-me-to-a-long-random-string

# Web origins allowed to call the API (admin panel, passenger web app). Comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Timezone used for route timetables ("06:00" departures). Default: Asia/Kolkata
TRANSIT_TIMEZONE=Asia/Kolkata

# --- Optional integrations (everything works without them, with simpler fallbacks) ---

# Road routing for route paths + driver re-routing. Free key: https://openrouteservice.org/dev/#/signup
# Without it, paths are straight lines between stops.
ORS_API_KEY=

# Private storage for driver documents. Free account: https://cloudinary.com  (format: cloudinary://key:secret@cloud)
# Without it, documents are stored on the server disk in backend/uploads/ (lost on Render redeploys).
CLOUDINARY_URL=

# Google Sign-In for passengers (Google Cloud Console -> Credentials -> OAuth client IDs).
# Without these, the "Continue with Google" button is hidden.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Minimum age for driver applications (default 21)
MIN_DRIVER_AGE=21

# Set to true to disable Expo push notifications (tests)
DISABLE_PUSH=false
