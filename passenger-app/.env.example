# Backend API (Android emulator -> your computer is 10.0.2.2; web -> http://localhost:5000/api)
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# Google Sign-In (optional). Web client ID from Google Cloud Console -> Credentials.
# Must match GOOGLE_WEB_CLIENT_ID on the backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS only: the reversed iOS client ID, e.g. com.googleusercontent.apps.1234-abcd
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
