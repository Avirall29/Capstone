{
  "expo": {
    "name": "Bus Driver",
    "slug": "transport-driver-capstone",
    "version": "2.0.0",
    "scheme": "busdriver",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16213E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.transport.driver",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.transport.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16213E"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CALL_PHONE",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Bus Driver shares your bus's location with passengers and the depot while a trip is running, including when the screen is off.",
          "locationWhenInUsePermission": "Bus Driver shares your bus's location with passengers and the depot while a trip is running.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#16213E"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Bus Driver uses the camera to photograph your driving licence and ID for your application.",
          "photosPermission": "Bus Driver lets you choose photos of your driving licence and ID for your application."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "a7ee5918-7888-4dca-a931-6b3b10ed557f"
      }
    }
  }
}
